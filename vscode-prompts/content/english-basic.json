  "summaries": {
    "g01": { "id": "g01", "title": "Verb to be", "readMinutes": 3,
      "intro": "to be ແປວ່າ 'ເປັນ / ຢູ່ / ແມ່ນ' ໃຊ້ບອກວ່າຜູ້ໃດເປັນໃຜ ຢູ່ໃສ ຫຼື ເປັນແນວໃດ",
      "keyPoints": ["I ໃຊ້ am", "he / she / it ໃຊ້ is", "you / we / they ໃຊ້ are", "ປະໂຫຍກປະຕິເສດ ເຕີມ not: I am not, she isn't", "ຄຳຖາມ ເອົາ am/is/are ໄວ້ໜ້າ: Are you a student?"],
      "codeSample": "I        -> am\nhe/she/it -> is\nyou/we/they -> are",
      "table": [ { "from": "I am", "to": "I'm" }, { "from": "she is", "to": "she's" }, { "from": "they are", "to": "they're" }, { "from": "is not", "to": "isn't" } ] },
    "g02": { "id": "g02", "title": "Subject pronouns & possessive adjectives", "readMinutes": 3,
      "intro": "ຄຳແທນນາມ (I, you...) ໃຊ້ເປັນປະທານ ສ່ວນ my, your... ບອກວ່າເປັນຂອງໃຜ ແລະ ຕ້ອງມີນາມຕາມຫຼັງ",
      "keyPoints": ["I → my", "you → your", "he → his, she → her, it → its", "we → our, they → their", "its (ຂອງມັນ) ບໍ່ມີ ' — it's = it is"],
      "codeSample": "she -> her book\nthey -> their house",
      "table": [ { "from": "I", "to": "my" }, { "from": "he", "to": "his" }, { "from": "she", "to": "her" }, { "from": "we", "to": "our" }, { "from": "they", "to": "their" } ] },
    "g03": { "id": "g03", "title": "a / an and plurals", "readMinutes": 3,
      "intro": "a / an ໃຊ້ກັບນາມນັບໄດ້ ຈຳນວນດຽວ. ພະຫູພົດ (ຫຼາຍອັນ) ສ່ວນຫຼາຍເຕີມ -s",
      "keyPoints": ["a ໃຊ້ກ່ອນສຽງພະຍັນຊະນະ: a book, a university", "an ໃຊ້ກ່ອນສຽງສະຫຼະ: an apple, an hour", "ພະຫູພົດທົ່ວໄປ ເຕີມ -s: books", "ລົງທ້າຍ -s, -sh, -ch, -x ເຕີມ -es: boxes", "ບໍ່ປົກກະຕິ: man → men, child → children"],
      "codeSample": "if (sound == vowel) 'an' else 'a'",
      "table": [ { "from": "box", "to": "boxes" }, { "from": "city", "to": "cities" }, { "from": "man", "to": "men" }, { "from": "child", "to": "children" } ] },
    "g04": { "id": "g04", "title": "this / that / these / those", "readMinutes": 2,
      "intro": "ໃຊ້ຊີ້ສິ່ງຂອງ. ໃກ້ໃຊ້ this/these ໄກໃຊ້ that/those",
      "keyPoints": ["this = ອັນນີ້ (ໃກ້, 1 ອັນ)", "these = ເຫຼົ່ານີ້ (ໃກ້, ຫຼາຍອັນ)", "that = ອັນນັ້ນ (ໄກ, 1 ອັນ)", "those = ເຫຼົ່ານັ້ນ (ໄກ, ຫຼາຍອັນ)"],
      "codeSample": "near + 1 = this\nnear + many = these\nfar + 1 = that\nfar + many = those",
      "table": [ { "from": "this pen", "to": "these pens" }, { "from": "that car", "to": "those cars" } ] },
    "g05": { "id": "g05", "title": "Present Simple", "readMinutes": 4,
      "intro": "ໃຊ້ເວົ້າເຖິງສິ່ງທີ່ເຮັດເປັນປະຈຳ ນິໄສ ຫຼື ຄວາມຈິງທົ່ວໄປ",
      "keyPoints": ["he / she / it ກິລິຍາເຕີມ -s: she works", "ປະຕິເສດ: don't / doesn't + ກິລິຍາຮູບປົກກະຕິ", "ຄຳຖາມ: Do / Does + ປະທານ + ກິລິຍາ?", "have → has, go → goes, study → studies"],
      "codeSample": "if (subject in [he, she, it]) verb + 's'\nelse verb",
      "table": [ { "from": "I work", "to": "she works" }, { "from": "I go", "to": "he goes" }, { "from": "I don't like", "to": "she doesn't like" } ] },
    "g06": { "id": "g06", "title": "Adverbs of frequency", "readMinutes": 2,
      "intro": "ບອກວ່າເຮັດເລື້ອຍປານໃດ ວາງໄວ້ໜ້າກິລິຍາຫຼັກ ແຕ່ຫຼັງ to be",
      "keyPoints": ["always 100% > usually > often > sometimes > never 0%", "I always get up at 6.", "She is never late. (ຫຼັງ is)"],
      "codeSample": "always 100%\nusually  80%\noften    60%\nsometimes 40%\nnever     0%",
      "table": [ { "from": "I eat breakfast.", "to": "I usually eat breakfast." }, { "from": "He is late.", "to": "He is often late." } ] },
    "g07": { "id": "g07", "title": "There is / There are", "readMinutes": 2,
      "intro": "ໃຊ້ບອກວ່າມີສິ່ງໃດຢູ່ໃສ",
      "keyPoints": ["There is + ຈຳນວນດຽວ: There is a bank.", "There are + ຫຼາຍ: There are two chairs.", "ຄຳຖາມ: Is there...? / Are there...?", "ປະຕິເສດ: There isn't / There aren't any"],
      "codeSample": "count == 1 ? 'There is' : 'There are'",
      "table": [ { "from": "a book", "to": "There is a book." }, { "from": "three books", "to": "There are three books." } ] },
    "g08": { "id": "g08", "title": "can / can't", "readMinutes": 2,
      "intro": "can ບອກຄວາມສາມາດ ຫຼື ຂໍອະນຸຍາດ ກິລິຍາຫຼັງ can ບໍ່ເຕີມ -s",
      "keyPoints": ["I / she / they can swim. (ບໍ່ມີ cans)", "ປະຕິເສດ: can't = cannot", "ຄຳຖາມ: Can you speak English?", "ຂໍອະນຸຍາດ: Can I open the window?"],
      "codeSample": "subject + can + verb (no -s, no to)",
      "table": [ { "from": "She can to sing.", "to": "She can sing." }, { "from": "He cans drive.", "to": "He can drive." } ] },
    "g09": { "id": "g09", "title": "Present Continuous", "readMinutes": 3,
      "intro": "ໃຊ້ເວົ້າເຖິງສິ່ງທີ່ກຳລັງເກີດຂຶ້ນຕອນນີ້",
      "keyPoints": ["am / is / are + ກິລິຍາ-ing", "I'm reading. She's cooking.", "ຄຳທີ່ມັກໃຊ້: now, at the moment, look!", "run → running, write → writing"],
      "codeSample": "be + verb + 'ing'",
      "table": [ { "from": "read", "to": "reading" }, { "from": "write", "to": "writing" }, { "from": "swim", "to": "swimming" } ] },
    "g10": { "id": "g10", "title": "was / were", "readMinutes": 2,
      "intro": "ອະດີດຂອງ to be",
      "keyPoints": ["I / he / she / it → was", "you / we / they → were", "ປະຕິເສດ: wasn't / weren't", "ຄຳຖາມ: Were you at home yesterday?"],
      "codeSample": "am, is -> was\nare    -> were",
      "table": [ { "from": "I am tired.", "to": "I was tired." }, { "from": "They are here.", "to": "They were here." } ] },
    "g11": { "id": "g11", "title": "Past Simple", "readMinutes": 4,
      "intro": "ໃຊ້ເວົ້າເຖິງເຫດການທີ່ເກີດຂຶ້ນ ແລະ ຈົບໄປແລ້ວໃນອະດີດ",
      "keyPoints": ["ກິລິຍາປົກກະຕິ ເຕີມ -ed: walk → walked", "ກິລິຍາບໍ່ປົກກະຕິ ຕ້ອງຈື່: go → went", "ປະຕິເສດ: didn't + ກິລິຍາຮູບປົກກະຕິ", "ຄຳຖາມ: Did you go...?", "ຄຳບອກເວລາ: yesterday, last week, ago"],
      "codeSample": "if (verb.regular) past = verb + 'ed'\nelse past = irregular[verb]",
      "table": [ { "from": "walk", "to": "walked" }, { "from": "go", "to": "went" }, { "from": "eat", "to": "ate" }, { "from": "see", "to": "saw" }, { "from": "buy", "to": "bought" } ] },
    "g12": { "id": "g12", "title": "be going to", "readMinutes": 3,
      "intro": "ໃຊ້ເວົ້າເຖິງແຜນທີ່ຕັດສິນໃຈໄວ້ແລ້ວ ຫຼື ສິ່ງທີ່ເຫັນວ່າກຳລັງຈະເກີດ",
      "keyPoints": ["am / is / are + going to + ກິລິຍາ", "I'm going to study tonight.", "Look at the clouds! It's going to rain.", "ຄຳຖາມ: Are you going to...?"],
      "codeSample": "be + going to + verb",
      "table": [ { "from": "I study (plan)", "to": "I'm going to study." }, { "from": "she visit", "to": "She's going to visit." } ] },

    "v01": { "id": "v01", "title": "Numbers 1–100", "readMinutes": 3,
      "intro": "ຕົວເລກໃຊ້ທຸກມື້ ລະວັງ -teen ກັບ -ty ອອກສຽງຕ່າງກັນ",
      "keyPoints": ["13 thirteen ↔ 30 thirty", "15 fifteen ↔ 50 fifty", "21 = twenty-one (ມີ -)", "100 = one hundred"],
      "codeSample": "teen -> 13..19 (ສຽງໜັກທ້າຍ)\nty   -> 20,30..90 (ສຽງໜັກໜ້າ)",
      "table": [ { "from": "12", "to": "twelve" }, { "from": "13", "to": "thirteen" }, { "from": "40", "to": "forty" }, { "from": "99", "to": "ninety-nine" } ] },
    "v02": { "id": "v02", "title": "Days, months & time", "readMinutes": 3,
      "intro": "ມື້ ແລະ ເດືອນ ຂຶ້ນຕົ້ນດ້ວຍຕົວໃຫຍ່ສະເໝີ",
      "keyPoints": ["on + ມື້: on Monday", "in + ເດືອນ/ປີ: in May, in 2026", "at + ເວລາ: at 7 o'clock", "half past six = 6:30, quarter to nine = 8:45"],
      "codeSample": "on  -> day\nin  -> month, year\nat  -> time",
      "table": [ { "from": "ວັນຈັນ", "to": "Monday" }, { "from": "ວັນເສົາ", "to": "Saturday" }, { "from": "ເດືອນມັງກອນ", "to": "January" }, { "from": "6:30", "to": "half past six" } ] },
    "v03": { "id": "v03", "title": "Family", "readMinutes": 2,
      "intro": "ຄຳສັບຄອບຄົວ ແລະ ການໃຊ້ 's ບອກຄວາມເປັນເຈົ້າຂອງ",
      "keyPoints": ["mother, father → parents", "brother, sister", "grandmother, grandfather", "aunt, uncle, cousin", "Tom's sister = ເອື້ອຍ/ນ້ອງສາວຂອງ Tom"],
      "codeSample": "owner + 's + thing\nTom's bag",
      "table": [ { "from": "ພໍ່ແມ່", "to": "parents" }, { "from": "ພີ່ນ້ອງຊາຍ", "to": "brother" }, { "from": "ລູກພີ່ລູກນ້ອງ", "to": "cousin" }, { "from": "ລຸງ/ອາ", "to": "uncle" } ] },
    "v04": { "id": "v04", "title": "Daily routine", "readMinutes": 2,
      "intro": "ກິລິຍາທີ່ໃຊ້ເລົ່າກິດຈະວັດປະຈຳວັນ ໃຊ້ຄູ່ກັບ Present Simple",
      "keyPoints": ["get up, have a shower, have breakfast", "go to school, start / finish work", "have lunch / dinner, do homework", "go to bed"],
      "codeSample": "06:00 get up\n07:00 have breakfast\n22:00 go to bed",
      "table": [ { "from": "ຕື່ນນອນ", "to": "get up" }, { "from": "ອາບນ້ຳ", "to": "have a shower" }, { "from": "ເຮັດວຽກບ້ານ", "to": "do homework" }, { "from": "ເຂົ້ານອນ", "to": "go to bed" } ] },
    "v05": { "id": "v05", "title": "Food & drink", "readMinutes": 3,
      "intro": "ນາມນັບໄດ້ ແລະ ນັບບໍ່ໄດ້ ໃຊ້ some / any ຕ່າງກັນ",
      "keyPoints": ["ນັບໄດ້: an apple, two eggs", "ນັບບໍ່ໄດ້: rice, water, milk (ບໍ່ເຕີມ -s)", "some ໃນປະໂຫຍກບອກເລົ່າ, any ໃນຄຳຖາມ/ປະຕິເສດ", "a bottle of water, a cup of coffee"],
      "codeSample": "countable   -> a/an, -s\nuncountable -> some, no -s",
      "table": [ { "from": "ເຂົ້າ", "to": "rice" }, { "from": "ໄຂ່", "to": "egg" }, { "from": "ນ້ຳ", "to": "water" }, { "from": "ໄກ່", "to": "chicken" } ] },
    "v06": { "id": "v06", "title": "Jobs & places", "readMinutes": 2,
      "intro": "ບອກອາຊີບໃຊ້ a / an ສະເໝີ: She's a doctor.",
      "keyPoints": ["teacher → school", "doctor, nurse → hospital", "waiter → restaurant", "engineer, developer → office", "I'm an engineer. (an ເພາະສຽງສະຫຼະ)"],
      "codeSample": "job -> place\ndoctor -> hospital",
      "table": [ { "from": "ຄູ", "to": "teacher" }, { "from": "ໝໍ", "to": "doctor" }, { "from": "ພະນັກງານເສີບ", "to": "waiter" }, { "from": "ນັກພັດທະນາ", "to": "developer" } ] },

    "p01": { "id": "p01", "title": "Greetings & introductions", "readMinutes": 2,
      "intro": "ປະໂຫຍກທັກທາຍ ແລະ ແນະນຳຕົວທີ່ໃຊ້ທຸກມື້",
      "keyPoints": ["Hi / Hello. Good morning.", "What's your name? — My name's Noy.", "Where are you from? — I'm from Laos.", "Nice to meet you. — Nice to meet you, too.", "How are you? — I'm fine, thanks. And you?"],
      "codeSample": "> What's your name?\n< My name's Noy.",
